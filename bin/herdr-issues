#!/usr/bin/env python3
"""herdr-issues: a GitHub issues / PRs panel docked beside your agents.

  herdr-issues toggle            open the panel right of the focused pane, or close it
  herdr-issues panel             the TUI (run by herdr inside the plugin pane)
  herdr-issues run <issue-url>   run the issue with codex-cage and show its progress
                                 in herdr (what `c` starts in the cage tab)

Needs an authenticated `gh`. Python 3.9+ standard library only.
"""
import curses
import json
import locale
import os
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import threading
import time
import unicodedata
from datetime import datetime, timezone

PLUGIN_ID = os.environ.get("HERDR_PLUGIN_ID") or "jhowliu.issues"
HERDR = os.environ.get("HERDR_BIN_PATH") or "herdr"
STATE_DIR = os.environ.get("HERDR_PLUGIN_STATE_DIR") or os.path.expanduser("~/.local/state/herdr-issues")
PANELS_FILE = os.path.join(STATE_DIR, "panels.json")  # tab id -> panel pane id
REFRESH_SECONDS = 60
PANEL_WIDTH = 0.36  # share of the split the panel ends up with

# ---------------------------------------------------------------- helpers


def run(args, cwd=None, timeout=30):
    p = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    return p.returncode, p.stdout, p.stderr


def herdr(*args):
    code, out, err = run([HERDR, *args])
    try:
        data = json.loads(out) if out.strip() else {}
    except ValueError:
        data = {}
    if code != 0 or "error" in data:
        msg = data.get("error", {}).get("message") if isinstance(data.get("error"), dict) else None
        raise RuntimeError(msg or err.strip() or out.strip() or "herdr %s failed" % " ".join(args))
    return data.get("result", data)


def gh_json(args, cwd):
    code, out, err = run(["gh", *args], cwd=cwd)
    if code != 0:
        raise RuntimeError((err or out).strip().splitlines()[-1] if (err or out).strip() else "gh failed")
    return json.loads(out or "null")


def load_panels():
    try:
        with open(PANELS_FILE) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_panels(panels):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = PANELS_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(panels, f)
    os.replace(tmp, PANELS_FILE)


def char_width(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def text_width(s):
    return sum(char_width(c) for c in s)


def truncate(s, width):
    """Cut s to `width` terminal cells, ending in an ellipsis when cut."""
    if width <= 0:
        return ""
    if text_width(s) <= width:
        return s
    out, used = [], 0
    for c in s:
        w = char_width(c)
        if used + w > width - 1:
            break
        out.append(c)
        used += w
    return "".join(out) + "…"


def wrap(text, width):
    """Wrap by terminal cells: break at spaces, hard-break long or CJK runs."""
    width = max(width, 4)
    lines = []
    for para in (text or "").replace("\r", "").replace("\t", "    ").split("\n"):
        line, used = "", 0
        for tok in re.findall(r"\S+|\s+", para):
            tw = text_width(tok)
            if tok.isspace():
                if used + tw <= width:
                    line, used = line + tok, used + tw
                else:
                    lines.append(line.rstrip())
                    line, used = "", 0
            elif used + tw <= width:
                line, used = line + tok, used + tw
            elif tw <= width and line.strip():
                lines.append(line.rstrip())
                line, used = tok, tw
            else:
                for c in tok:
                    cw = char_width(c)
                    if used + cw > width:
                        lines.append(line.rstrip())
                        line, used = "", 0
                    line, used = line + c, used + cw
        lines.append(line.rstrip())
    return lines


def ago(iso):
    if not iso:
        return ""
    try:
        t = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except ValueError:
        return ""
    s = max(0, (datetime.now(timezone.utc) - t).total_seconds())
    for unit, size in (("y", 31536000), ("mo", 2592000), ("w", 604800), ("d", 86400), ("h", 3600), ("m", 60)):
        if s >= size:
            return "%d%s" % (s // size, unit)
    return "now"


# ---------------------------------------------------------------- markdown
# A small GitHub-flavoured markdown renderer for the detail view. Every output
# line is a list of (text, curses attr) segments. GitHub renders a single
# newline in issue and PR text as a line break, so source lines stay lines.

ITALIC = getattr(curses, "A_ITALIC", curses.A_UNDERLINE)
INLINE_RE = re.compile(
    r"(?P<esc>\\[\\`*_{}\[\]()#+\-.!|>~])"
    r"|(?P<code>(?P<ticks>`+)(?P<codetext>.+?)(?P=ticks))"
    r"|(?P<img>!\[(?P<alt>[^\]]*)\]\([^)]*\))"
    r"|(?P<link>\[(?P<ltext>[^\]]+)\]\((?P<href>[^)\s]+)(?:\s+\"[^\"]*\")?\))"
    r"|(?P<auto><(?P<autourl>https?://[^>\s]+)>)"
    r"|(?P<url>https?://[^\s<>()]*[^\s<>().,;:!?'\"])"
    r"|(?P<bold>\*\*(?P<btext>.+?)\*\*|__(?P<btext2>.+?)__)"
    r"|(?P<strike>~~(?P<stext>.+?)~~)"
    r"|(?P<em>(?<![\w*])\*(?![\s*])(?P<etext>.+?)(?<![\s*])\*(?![\w*])"
    r"|(?<![\w_])_(?![\s_])(?P<etext2>.+?)(?<![\s_])_(?![\w_]))"
)
HTML_TAG_RE = re.compile(
    r"</?(?:details|summary|p|div|span|sub|sup|b|i|em|strong|kbd|a|picture|source|br|hr|img)\b[^>]*>", re.I)
HEADING_RE = re.compile(r"^\s{0,3}(#{1,6})\s+(.*?)(?:\s+#+)?\s*$")
HR_RE = re.compile(r"^\s{0,3}([-*_])(?:\s*\1){2,}\s*$")
FENCE_RE = re.compile(r"^\s*(`{3,}|~{3,})")
LIST_RE = re.compile(r"^(\s*)([-*+]|\d{1,9}[.)])\s+(.*)$")
QUOTE_RE = re.compile(r"^\s*>\s?(.*)$")
TABLE_SEP_RE = re.compile(r"^\s*\|?\s*:?-+:?\s*(?:\|\s*:?-+:?\s*)+\|?\s*$")


def recolor(attr, n):
    """Swap the colour in attr for pair n (or-ing two colour pairs garbles both)."""
    return (attr & ~curses.A_COLOR) | color(n)


def inline(text, attr=0):
    spans, pos = [], 0
    for m in INLINE_RE.finditer(text):
        if m.start() > pos:
            spans.append((HTML_TAG_RE.sub("", text[pos:m.start()]), attr))
        kind = m.lastgroup
        if kind == "esc":
            spans.append((m.group("esc")[1], attr))
        elif kind == "code":
            spans.append((m.group("codetext").strip(), recolor(attr, 4)))
        elif kind == "img":
            spans.append(("▣ " + (m.group("alt") or "image"), attr | curses.A_DIM))
        elif kind == "link":
            spans += inline(m.group("ltext"), recolor(attr, 6) | curses.A_UNDERLINE)
        elif kind in ("auto", "url"):
            spans.append((m.group("autourl") or m.group("url"), recolor(attr, 6) | curses.A_UNDERLINE))
        elif kind == "bold":
            spans += inline(m.group("btext") or m.group("btext2"), attr | curses.A_BOLD)
        elif kind == "strike":
            spans += inline(m.group("stext"), attr | curses.A_DIM)
        elif kind == "em":
            spans += inline(m.group("etext") or m.group("etext2"), attr | ITALIC)
        pos = m.end()
    if pos < len(text):
        spans.append((HTML_TAG_RE.sub("", text[pos:]), attr))
    return [s for s in spans if s[0]]


def seg_width(segs):
    return sum(text_width(t) for t, _ in segs)


def merge(segs):
    out = []
    for t, a in segs:
        if out and out[-1][1] == a:
            out[-1] = (out[-1][0] + t, a)
        elif t:
            out.append((t, a))
    return out


def wrap_spans(spans, width, prefix=(), indent=()):
    """Wrap styled spans to `width` cells. prefix starts the first line, indent the rest."""
    words, cur = [], []
    for text, attr in spans:
        for tok in re.findall(r"\S+|\s+", text):
            if tok.isspace():
                if cur:
                    words.append(cur)
                    cur = []
                words.append(None)
            else:
                cur.append((tok, attr))  # glued to the previous piece: `code`, stays one word
    if cur:
        words.append(cur)

    indent = list(indent)
    base = seg_width(indent)
    lines = []
    state = {"line": list(prefix), "used": seg_width(prefix), "has": False}

    def flush():
        lines.append(merge(state["line"]))
        state.update(line=list(indent), used=base, has=False)

    space = False
    for word in words:
        if word is None:
            space = state["has"]
            continue
        ww = seg_width(word)
        gap = 1 if space else 0
        space = False
        if state["used"] + gap + ww <= width:
            if gap:
                state["line"].append((" ", 0))
            state["line"].extend(word)
            state["used"] += gap + ww
            state["has"] = True
            continue
        wide = ww > width - base or any(char_width(c) == 2 for t, _ in word for c in t)
        if not wide:
            if state["has"]:
                flush()
            state["line"].extend(word)
            state["used"] += ww
            state["has"] = True
            continue
        # CJK runs and over-long words fill the current line, then break anywhere
        if gap and state["used"] + gap < width:
            state["line"].append((" ", 0))
            state["used"] += 1
        for t, a in word:
            for c in t:
                cw = char_width(c)
                if state["used"] + cw > width and state["has"]:
                    flush()
                state["line"].append((c, a))
                state["used"] += cw
                state["has"] = True
    lines.append(merge(state["line"]))
    return lines


def hard_wrap(text, width):
    lines, line, used = [], "", 0
    for c in text:
        cw = char_width(c)
        if used + cw > width and line:
            lines.append(line)
            line, used = "", 0
        line, used = line + c, used + cw
    lines.append(line)
    return lines


def split_row(s):
    s = s.strip()
    if s.startswith("|"):
        s = s[1:]
    if s.endswith("|") and not s.endswith("\\|"):
        s = s[:-1]
    return [c.strip() for c in re.split(r"(?<!\\)\|", s)]


def render_table(rows, width):
    cells = [[inline(c) for c in r] for r in rows]
    ncol = max(len(r) for r in cells)
    for r in cells:
        r.extend([[]] * (ncol - len(r)))
    head = lambda segs: [(t, a | curses.A_BOLD) for t, a in segs]
    sep = (" │ ", curses.A_DIM)
    widths = [max(seg_width(r[c]) for r in cells) for c in range(ncol)]
    out = []
    if sum(widths) + 3 * (ncol - 1) <= width:
        for n, r in enumerate(cells):
            line = []
            for c in range(ncol):
                segs = r[c] if n else head(r[c])
                if c:
                    line.append(sep)
                line += segs + [(" " * (widths[c] - seg_width(segs)), 0)]
            out.append(merge(line))
            if n == 0:
                out.append([("─┼─".join("─" * wd for wd in widths), curses.A_DIM)])
        return out
    for n, r in enumerate(cells):  # too wide to align: one wrapped line per row
        spans = []
        for c in range(ncol):
            if c:
                spans.append(sep)
            spans += r[c] if n else head(r[c])
        out += wrap_spans(spans, width)
    return out


def md_lines(md):
    return re.sub(r"<!--.*?-->", "", md or "", flags=re.S).replace("\r", "").split("\n")


def read_fence(src, i):
    """Fenced block opening at src[i] -> (language, code lines, index after the block)."""
    s = src[i].expandtabs(4).rstrip()
    fence = FENCE_RE.match(s)
    mark = fence.group(1)
    lang = (s[fence.end():].split() or [""])[0].lower()
    closing = re.compile(r"^\s*%s{%d,}\s*$" % (re.escape(mark[0]), len(mark)))
    i += 1
    code = []
    while i < len(src) and not closing.match(src[i]):
        code.append(src[i].expandtabs(4).rstrip())
        i += 1
    return lang, code, i + 1


# ---------------------------------------------------------------- mermaid
# bin/mermaid-text.mjs draws diagrams with the beautiful-mermaid npm package
# (`npm install` in the plugin dir). Without it, mermaid blocks show as source.

PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
MERMAID_JS = os.path.join(PLUGIN_DIR, "bin", "mermaid-text.mjs")
_mermaid = {}  # mermaid source -> candidate drawings (lists of lines), or None if it can't be drawn
_mermaid_hint = None  # set when the renderer isn't installed


def prerender_mermaid(texts):
    """Draw every mermaid block in these markdown texts with one node call. Runs off the UI thread."""
    global _mermaid_hint
    todo = []
    for md in texts:
        src, i = md_lines(md), 0
        while i < len(src):
            if not FENCE_RE.match(src[i]):
                i += 1
                continue
            lang, code, i = read_fence(src, i)
            key = "\n".join(code)
            if lang == "mermaid" and key not in _mermaid and key not in todo:
                todo.append(key)
    if not todo:
        return
    setup = "(cd %s && npm install) to draw diagrams" % PLUGIN_DIR.replace(os.path.expanduser("~"), "~", 1)
    if not shutil.which("node"):
        _mermaid_hint = "needs node; then " + setup
        return
    try:
        p = subprocess.run(["node", MERMAID_JS], input=json.dumps(todo), capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return
    if p.returncode != 0:
        if "beautiful-mermaid" in p.stderr:
            _mermaid_hint = setup
        return
    try:
        results = json.loads(p.stdout)
    except ValueError:
        return
    _mermaid_hint = None
    for key, drawings in zip(todo, results):
        _mermaid[key] = [d.split("\n") for d in drawings] if drawings else None


def draw_mermaid(code, width):
    """The roomiest drawing that fits the width, else the narrowest one cut at the edge."""
    drawings = _mermaid.get("\n".join(code))
    if not drawings:
        return None
    widest = lambda d: max((text_width(l) for l in d), default=0)
    pick = next((d for d in drawings if widest(d) <= width), None)
    note = []
    if pick is None:
        pick = min(drawings, key=widest)
        note = [[("  ↳ cut at the panel edge · o opens it on GitHub", curses.A_DIM)]]
    return [[("  " + (truncate(l, width) if text_width(l) > width else l), 0)] for l in pick] + note


def render_code(lang, code, width):
    if lang == "mermaid":
        drawn = draw_mermaid(code, width - 2)
        if drawn:
            return drawn
    out = [[("  " + piece, color(4))] for line in code or [""] for piece in hard_wrap(line, width - 2)]
    if lang == "mermaid" and _mermaid_hint:
        out = wrap_spans([("mermaid: " + _mermaid_hint, curses.A_DIM)], width) + out
    return out


def render_markdown(md, width):
    width = max(width, 10)
    src = md_lines(md)
    out = []
    list_indent = None  # hanging indent of the list item that indented lines continue

    def blank():
        if out and out[-1]:
            out.append([])

    i = 0
    while i < len(src):
        raw = src[i].expandtabs(4)
        s = raw.rstrip()
        if FENCE_RE.match(s):
            lang, code, i = read_fence(src, i)
            out += render_code(lang, code, width)
            list_indent = None
            continue
        if not s.strip():
            blank()
            i += 1
            continue
        m = HEADING_RE.match(s)
        if m:
            blank()
            attr = recolor(curses.A_BOLD, 5) | (curses.A_UNDERLINE if len(m.group(1)) == 1 else 0)
            out += wrap_spans(inline(m.group(2), attr), width)
            list_indent = None
            i += 1
            continue
        if HR_RE.match(s):
            out.append([("─" * width, curses.A_DIM)])
            list_indent = None
            i += 1
            continue
        if "|" in s and i + 1 < len(src) and TABLE_SEP_RE.match(src[i + 1]):
            rows = [split_row(s)]
            i += 2
            while i < len(src) and "|" in src[i] and src[i].strip():
                rows.append(split_row(src[i]))
                i += 1
            out += render_table(rows, width)
            list_indent = None
            continue
        m = QUOTE_RE.match(s)
        if m:
            inner = m.group(1)
            bar = [("│ ", curses.A_DIM)]
            alert = re.match(r"^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*$", inner, re.I)
            if alert:
                out.append(bar + [(alert.group(1).capitalize(), recolor(curses.A_BOLD, 5))])
            elif inner.strip():
                out += wrap_spans(inline(inner, curses.A_DIM), width, bar, bar)
            else:
                out.append(bar)
            list_indent = None
            i += 1
            continue
        m = LIST_RE.match(s)
        if m:
            level = min(len(m.group(1)) // 2, 6)
            marker, rest = m.group(2), m.group(3)
            task = re.match(r"^\[([ xX])\]\s+(.*)$", rest)
            if task:
                glyph, rest = ("☑" if task.group(1) in "xX" else "☐"), task.group(2)
            elif marker[0].isdigit():
                glyph = marker
            else:
                glyph = "•◦▪"[level % 3]
            pad = "  " * level
            list_indent = [(" " * (len(pad) + text_width(glyph) + 1), 0)]
            out += wrap_spans(inline(rest), width, [(pad, 0), (glyph + " ", color(5))], list_indent)
            i += 1
            continue
        if list_indent is not None and raw.startswith("  "):
            out += wrap_spans(inline(s.strip()), width, list_indent, list_indent)
            i += 1
            continue
        list_indent = None
        out += wrap_spans(inline(s.strip()), width)
        i += 1
    while out and not out[-1]:
        out.pop()
    while out and not out[0]:
        out.pop(0)
    return out


# ---------------------------------------------------------------- toggle


def pane_exists(pane_id):
    try:
        herdr("pane", "get", pane_id)
        return True
    except RuntimeError:
        return False


def focused_pane():
    pane_id = os.environ.get("HERDR_PANE_ID")
    if pane_id:
        try:
            return herdr("pane", "get", pane_id)["pane"]
        except (RuntimeError, KeyError):
            pass
    for p in herdr("pane", "list").get("panes", []):
        if p.get("focused"):
            return p
    raise RuntimeError("no focused pane")


def find_pane_id(obj):
    """Pull the new pane id out of a `plugin pane open` result, whatever its nesting."""
    if isinstance(obj, dict):
        if isinstance(obj.get("pane_id"), str):
            return obj["pane_id"]
        for v in obj.values():
            found = find_pane_id(v)
            if found:
                return found
    return None


def cmd_toggle():
    src = focused_pane()
    tab = src["tab_id"]
    # Panels killed with their tab or workspace never deregister; drop them.
    live = {p.get("pane_id") for p in herdr("pane", "list").get("panes", [])}
    panels = {t: p for t, p in load_panels().items() if p in live}

    # Pressed inside a panel, or this tab already has one: close it.
    owner = next((t for t, p in panels.items() if p == src["pane_id"]), None)
    target = src["pane_id"] if owner else panels.get(tab)
    if target and pane_exists(target):
        try:
            herdr("plugin", "pane", "close", target)
            panels.pop(owner or tab, None)
            save_panels(panels)
            return
        except RuntimeError:
            pass  # stale entry: that id now belongs to a non-plugin pane, so open a new panel
    panels.pop(tab, None)

    cwd = src.get("foreground_cwd") or src.get("cwd") or os.path.expanduser("~")
    result = herdr(
        "plugin", "pane", "open",
        "--plugin", PLUGIN_ID, "--entrypoint", "panel",
        "--placement", "split", "--direction", "right",
        "--target-pane", src["pane_id"], "--cwd", cwd, "--focus",
    )
    new_id = find_pane_id(result)
    if new_id:
        panels[tab] = new_id
        try:  # a 50/50 split is too wide for a list; give the space back
            herdr("pane", "resize", "--direction", "right", "--amount", str(0.5 - PANEL_WIDTH), "--pane", src["pane_id"])
        except RuntimeError:
            pass
    save_panels(panels)


# ---------------------------------------------------------------- codex-cage runs
# `c` runs an issue with codex-cage (github.com/jhowliu/codex-cage) in a background
# "cage" tab. codex-cage knows nothing about herdr: the cage pane runs
# `herdr-issues run`, which starts `codex-cage run` and mirrors the run's events
# (.codex-cage/runs/<run-id>/events.ndjson) into herdr's agent list. It keeps the
# issue's run state in .codex-cage/runs/delegate-<n>.json for the panel. That is
# the same file codex-cage's delegate skill writes, so its runs show up too.

CODEX_CAGE = os.environ.get("CODEX_CAGE_BIN") or "codex-cage"
CAGE_TAB = "cage"
CAGE_SOURCE = "herdr-issues"
CAGE_AGENT = "codex-cage"
RUN_POLL_SECONDS = 0.5
RUNS_REFRESH_SECONDS = 2


def repo_root(cwd):
    code, out, _ = run(["git", "rev-parse", "--show-toplevel"], cwd=cwd)
    return out.strip() if code == 0 and out.strip() else None


def cage_root(cwd):
    """The repo root when codex-cage can run this repo, else None."""
    root = repo_root(cwd)
    if root and shutil.which(CODEX_CAGE) and os.path.isfile(os.path.join(root, ".codex-cage.yml")):
        return root
    return None


def runs_dir(root):
    return os.path.join(root, ".codex-cage", "runs")


def state_path(root, number):
    return os.path.join(runs_dir(root), "delegate-%d.json" % number)


def read_json(path):
    try:
        with open(path) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else None
    except (OSError, ValueError):
        return None


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except PermissionError:
        return True  # it exists, under another user
    except (OSError, ValueError, TypeError):
        return False


def run_states(root):
    """Issue number -> the state of its latest run, from the delegate-<n>.json files."""
    states = {}
    try:
        names = os.listdir(runs_dir(root))
    except OSError:
        return states
    for name in names:
        m = re.match(r"^delegate-(\d+)\.json$", name)
        data = read_json(os.path.join(runs_dir(root), name)) if m else None
        if not data:
            continue
        if data.get("status") == "running" and not pid_alive(data.get("pid")):
            data = dict(data, status="stopped")  # its pane was closed mid-run
        states[int(m.group(1))] = data
    return states


def run_label(state):
    """(glyph, text, colour pair) that the panel shows for a run state."""
    status = state.get("status")
    if status == "running":
        return "◐", state.get("stage") or "running", 4
    if status == "succeeded":
        return "✓", "PR opened", 1
    if status == "failed":
        return "✗", state.get("failureCode") or "failed", 3
    if status == "crashed":
        return "✗", "crashed", 3
    return "■", "stopped", 0


class CageTracker:
    """Turns codex-cage run events into herdr updates for the run's pane.

    Updates are dicts: {"kind": "agent", "state", "message"},
    {"kind": "metadata", "title", "display"} (display is the line under the agent
    name in herdr's agent list, about 17 characters wide), and
    {"kind": "notification", "title", "body", "sound"}.
    """

    def __init__(self, issue_key):
        self.issue_key = issue_key
        self.title = issue_key
        self.stage = "starting"

    def started(self, run_id):
        # The agent report comes first: herdr attaches metadata to a reported agent.
        return [{"kind": "agent", "state": "working", "message": "run %s" % run_id}, self._metadata("starting")]

    def updates_for(self, event):
        kind = event.get("type")
        payload = event.get("payload") or {}
        if kind == "run.started":
            self.issue_key = payload.get("issueKey") or self.issue_key
            self.title = truncate(("%s %s" % (self.issue_key, payload.get("issueTitle") or "")).strip(), 80)
            return [self._metadata(self.stage)]
        if kind == "stage.started":
            attempt = event.get("stageAttempt") or 1
            stage = event.get("stage") or "?"
            return [self._working(stage if attempt <= 1 else "%s try %d" % (stage, attempt))]
        if kind == "implementation.iteration_started":
            return [self._working("implement %s/%s" % (payload.get("iteration"), payload.get("maxIterations")))]
        return []

    def finished(self, final):
        status = final.get("status")
        if status == "succeeded":
            state, label, display, sound = "idle", "PR opened", "PR opened", "done"
            detail = final.get("prUrl") or ""
        elif status == "failed":
            code = final.get("failureCode") or "failed"
            # The blocked icon already says it failed, so the list shows only the code.
            state, label, display, sound = "blocked", "failed: %s" % code, code, "request"
            detail = "Inspect it with: codex-cage runs show %s" % final.get("runId")
        else:
            state, label, display, sound = "blocked", "crashed", "crashed", "request"
            detail = "codex-cage exited with code %s; see the cage pane" % final.get("exitCode")
        self.stage = display
        return [
            self._metadata(display),
            {"kind": "agent", "state": state, "message": "%s. %s" % (label, detail)},
            {"kind": "notification", "title": "codex-cage %s: %s" % (self.issue_key, label), "body": detail, "sound": sound},
        ]

    def _working(self, label):
        self.stage = label
        return self._metadata(label)

    def _metadata(self, display):
        return {"kind": "metadata", "title": self.title, "display": display}


def report_args(update, pane_id, seq):
    """The herdr CLI arguments for one CageTracker update."""
    who = ["--source", CAGE_SOURCE, "--agent", CAGE_AGENT]
    if update["kind"] == "agent":
        return ["pane", "report-agent", pane_id, *who, "--state", update["state"],
                "--message", update["message"], "--seq", seq]
    if update["kind"] == "metadata":
        return ["pane", "report-metadata", pane_id, *who, "--title", update["title"],
                "--display-agent", update["display"], "--seq", seq]
    return ["notification", "show", update["title"], "--body", update["body"], "--sound", update["sound"]]


class HerdrReporter:
    """Sends updates to one pane. Best effort: the first failure turns it off."""

    def __init__(self, pane_id):
        self.pane_id = pane_id
        self.off = pane_id is None
        self.seq = 0

    def send(self, updates):
        for update in updates:
            if self.off:
                return
            # herdr orders reports by --seq; nanoseconds, like its own integrations
            self.seq = max(self.seq + 1, time.time_ns())
            try:
                herdr(*report_args(update, self.pane_id, str(self.seq)))
            except (RuntimeError, OSError, subprocess.SubprocessError) as e:
                self.off = True
                sys.stderr.write("herdr-issues: herdr status updates are off for this run: %s\n" % e)


class EventTail:
    """The complete lines appended to an NDJSON file since the last read. The file may not exist yet."""

    def __init__(self, path):
        self.path, self.offset, self.partial = path, 0, b""

    def read(self):
        try:
            with open(self.path, "rb") as f:
                f.seek(self.offset)
                data = f.read()
        except OSError:
            return []
        self.offset += len(data)
        lines = (self.partial + data).split(b"\n")
        self.partial = lines.pop()
        events = []
        for line in lines:
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if isinstance(event, dict):
                events.append(event)
        return events


def new_run_id():
    """A run id in codex-cage's own format, so the wrapper knows where the events land."""
    return "run-%s-%s" % (datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S"), secrets.token_hex(3))


def cage_pane(cwd):
    """A new shell pane in this workspace's cage tab. Your view stays where it is."""
    workspace = os.environ.get("HERDR_WORKSPACE_ID") or (os.environ.get("HERDR_TAB_ID") or "").split(":")[0]
    tabs = herdr("tab", "list", "--workspace", workspace).get("tabs", [])
    cage = next((t for t in tabs if t.get("label") == CAGE_TAB), None)
    if cage is None:
        created = herdr("tab", "create", "--workspace", workspace, "--label", CAGE_TAB, "--cwd", cwd, "--no-focus")
        return created["root_pane"]["pane_id"]
    panes = [p for p in herdr("pane", "list", "--workspace", workspace).get("panes", [])
             if p.get("tab_id") == cage["tab_id"]]
    if not panes:
        raise RuntimeError("the cage tab has no panes")
    direction = "right" if len(panes) % 2 else "down"  # alternate, so panes stay usable
    split = herdr("pane", "split", panes[-1]["pane_id"], "--direction", direction, "--cwd", cwd, "--no-focus")
    return split["pane"]["pane_id"]


def start_run_command(url):
    """What `c` types into the cage pane. `exit` closes the pane once you dismiss the run."""
    return "%s run %s; exit" % (shlex.quote(os.path.realpath(__file__)), shlex.quote(url))


def cmd_run(args):
    if len(args) != 1:
        sys.stderr.write("usage: herdr-issues run <issue-url>\n")
        return 2
    url = args[0]
    m = re.search(r"/issues/(\d+)", url)
    if not m:
        sys.stderr.write("herdr-issues run: expected a GitHub issue URL, got %s\n" % url)
        return 2
    number = int(m.group(1))
    root = repo_root(os.getcwd()) or os.getcwd()
    pane_id = os.environ.get("HERDR_PANE_ID") if os.environ.get("HERDR_ENV") == "1" else None
    run_id = new_run_id()
    state_file = state_path(root, number)
    result_file = os.path.join(runs_dir(root), "%s.result.json" % run_id)
    tracker = CageTracker("#%d" % number)
    reporter = HerdrReporter(pane_id)

    state = {"status": "running", "runId": run_id, "stage": tracker.stage, "issueUrl": url,
             "pane": pane_id, "pid": os.getpid()}
    write_json(state_file, state)
    reporter.send(tracker.started(run_id))

    # Docker mode always: a delegated run gets codex-cage's sandbox, whatever the config says.
    env = dict(os.environ, CODEX_CAGE_EXECUTION="docker")
    try:
        child = subprocess.Popen([CODEX_CAGE, "run", url, "--run-id", run_id, "--result-json", result_file],
                                 cwd=root, env=env)
    except OSError as e:
        sys.stderr.write("herdr-issues run: cannot start %s: %s\n" % (CODEX_CAGE, e))
        child = None
    code = 127 if child is None else None
    tail = EventTail(os.path.join(runs_dir(root), run_id, "events.ndjson"))
    while code is None:
        try:
            code = child.wait(timeout=RUN_POLL_SECONDS)
        except subprocess.TimeoutExpired:
            pass
        except KeyboardInterrupt:
            continue  # Ctrl-C reaches codex-cage too; let it stop and report
        for event in tail.read():
            updates = tracker.updates_for(event)
            reporter.send(updates)
            if updates and state["stage"] != tracker.stage:
                state["stage"] = tracker.stage
                write_json(state_file, state)

    result = read_json(result_file)
    try:
        os.remove(result_file)
    except OSError:
        pass
    if result and result.get("status") in ("succeeded", "failed"):
        final = {k: result.get(k) for k in ("runId", "status", "failureCode", "prUrl")}
    else:
        final = {"runId": run_id, "status": "crashed", "exitCode": code}
    final.update(issueUrl=url, pane=pane_id)
    write_json(state_file, final)
    reporter.send(tracker.finished(final))

    glyph, label, _ = run_label(final)
    print("\nherdr-issues: #%d %s %s %s" % (number, glyph, label, final.get("prUrl") or ""))
    if pane_id and sys.stdin.isatty():
        # Holding here keeps the result in herdr's agent list until you have seen it.
        try:
            input("Press Enter to finish. ")
        except (EOFError, KeyboardInterrupt):
            pass
    return code


# ---------------------------------------------------------------- panel

TABS = ("issues", "prs")
FILTERS = ("open", "closed", "all")


class Panel:
    def __init__(self, cwd):
        self.cwd = cwd
        self.tab = "issues"
        self.filter = "open"
        self.repo = None
        self.branch = None
        self.items = {"issues": [], "prs": []}
        self.error = None
        self.loading = False
        self.loaded_once = False
        self.fetched_at = 0.0
        self.sel = 0
        self.top = 0
        self.detail = None  # (kind, number) while the detail view is open
        self.detail_data = None
        self.detail_error = None
        self.dscroll = 0
        self._dcache = None
        self.flash = ("", 0.0)
        self.cage = None  # repo root when `c` can run issues with codex-cage
        self.runs = {}  # issue number -> run state, see run_states()
        self.runs_at = 0.0
        self.lock = threading.Lock()

    # -- data

    def refresh(self):
        if self.loading:
            return
        self.loading = True
        threading.Thread(target=self._fetch, daemon=True).start()

    def _fetch(self):
        try:
            repo = gh_json(["repo", "view", "--json", "nameWithOwner,url"], self.cwd)
            code, out, _ = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=self.cwd)
            branch = out.strip() if code == 0 else None
            issues = gh_json([
                "issue", "list", "--state", self.filter, "--limit", "100",
                "--json", "number,title,state,labels,assignees,author,updatedAt,url",
            ], self.cwd)
            prs = gh_json([
                "pr", "list", "--state", self.filter, "--limit", "100",
                "--json", "number,title,state,isDraft,headRefName,author,updatedAt,url,reviewDecision",
            ], self.cwd)
            cage = cage_root(self.cwd)
            with self.lock:
                self.repo, self.branch, self.error, self.cage = repo, branch, None, cage
                self.items = {"issues": issues or [], "prs": prs or []}
                if not self.loaded_once and not issues and prs:
                    self.tab = "prs"  # nothing to show under issues
                self.loaded_once = True
        except Exception as e:  # shown in the panel instead of crashing it
            with self.lock:
                self.error = str(e) or e.__class__.__name__
        finally:
            with self.lock:
                self.loading = False
                self.fetched_at = time.time()
                self.clamp()

    def open_detail(self):
        item = self.current()
        if not item:
            return
        kind = self.tab
        self.detail, self.detail_data, self.detail_error, self.dscroll = (kind, item["number"]), None, None, 0
        threading.Thread(target=self._fetch_detail, args=(kind, item["number"]), daemon=True).start()

    def _fetch_detail(self, kind, number):
        try:
            if kind == "issues":
                fields = "number,title,state,author,labels,assignees,body,comments,url,createdAt"
                data = gh_json(["issue", "view", str(number), "--json", fields], self.cwd)
            else:
                fields = ("number,title,state,isDraft,author,labels,body,comments,url,createdAt,"
                          "headRefName,baseRefName,additions,deletions,changedFiles,reviewDecision")
                data = gh_json(["pr", "view", str(number), "--json", fields], self.cwd)
            prerender_mermaid([data.get("body") or ""] + [c.get("body") or "" for c in data.get("comments") or []])
            with self.lock:
                if self.detail == (kind, number):
                    self.detail_data = data
        except Exception as e:
            with self.lock:
                if self.detail == (kind, number):
                    self.detail_error = str(e)

    def load_runs(self):
        runs = run_states(self.cage) if self.cage else {}
        with self.lock:
            self.runs, self.runs_at = runs, time.time()

    def current(self):
        rows = self.items.get(self.tab) or []
        return rows[self.sel] if 0 <= self.sel < len(rows) else None

    def clamp(self):
        n = len(self.items.get(self.tab) or [])
        self.sel = max(0, min(self.sel, n - 1))

    def say(self, msg):
        self.flash = (msg, time.time())

    # -- actions

    def open_in_browser(self):
        url = (self.detail_data or {}).get("url") if self.detail else (self.current() or {}).get("url")
        if not url:
            return
        opener = "open" if shutil.which("open") else "xdg-open"
        subprocess.Popen([opener, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.say("opened in browser")

    def send_to_agent(self):
        item = self.detail_data if self.detail else self.current()
        if not item:
            return
        kind = self.detail[0] if self.detail else self.tab
        if kind == "issues":
            text = 'GitHub issue #%s "%s" %s ' % (item["number"], item["title"], item.get("url", ""))
        else:
            text = 'PR #%s "%s" (%s) %s ' % (item["number"], item["title"], item.get("headRefName", ""), item.get("url", ""))
        try:
            agent = self.target_agent()
            if not agent:
                self.say("no agent in this tab")
                return
            herdr("pane", "send-text", agent["pane_id"], text)
            try:  # hand focus to the agent so you can keep typing
                herdr("agent", "focus", agent["pane_id"])
            except RuntimeError:
                pass
            self.say("pasted into %s" % (agent.get("agent") or agent["pane_id"]))
        except RuntimeError as e:
            self.say("send failed: %s" % e)

    def start_run(self):
        """`c`: check the issue with codex-cage, then run it in a new pane of the cage tab."""
        kind = self.detail[0] if self.detail else self.tab
        item = self.detail_data if self.detail else self.current()
        if kind != "issues" or not item:
            self.say("c runs issues, not PRs")
            return
        if not self.cage:
            self.say("c needs codex-cage on PATH and a .codex-cage.yml in this repo")
            return
        number = item["number"]
        if (item.get("state") or "").upper() != "OPEN":
            self.say("#%d is closed" % number)
            return
        if (self.runs.get(number) or {}).get("status") == "running":
            self.say("#%d is already running in the cage tab" % number)
            return
        self.say("checking #%d…" % number)
        threading.Thread(target=self._start_run, args=(number, item["url"], self.cage), daemon=True).start()

    def _start_run(self, number, url, root):
        try:
            _, out, err = run([CODEX_CAGE, "check", url, "--json"], cwd=root, timeout=120)
            try:
                result = json.loads(out)
            except ValueError:
                lines = (err or out).strip().splitlines()
                raise RuntimeError(lines[-1] if lines else "codex-cage check failed")
            findings = result.get("findings") or []
            if not result.get("ready"):
                errors = [f.get("message") for f in findings if f.get("level") == "error"]
                self.say("#%d not ready: %s" % (number, errors[0] if errors else "run codex-cage check"))
                return
            herdr("pane", "run", cage_pane(root), start_run_command(url))
            warnings = sum(1 for f in findings if f.get("level") == "warning")
            self.say("#%d started in the cage tab%s" % (number, " · %d check warnings" % warnings if warnings else ""))
        except Exception as e:  # shown in the footer instead of crashing the panel
            self.say("run failed: %s" % e)

    def target_agent(self):
        me, tab = os.environ.get("HERDR_PANE_ID"), os.environ.get("HERDR_TAB_ID")
        agents = [a for a in herdr("agent", "list").get("agents", []) if a.get("pane_id") != me]
        same_tab = [a for a in agents if a.get("tab_id") == tab]
        if same_tab:
            return same_tab[0]
        ws = tab.split(":")[0] if tab else None
        same_ws = [a for a in agents if a.get("workspace_id") == ws]
        return same_ws[0] if len(same_ws) == 1 else None

    # -- drawing

    def draw(self, scr):
        scr.erase()
        h, w = scr.getmaxyx()
        if h < 6 or w < 20:
            put(scr, 0, 0, truncate("issues: too small", w))
            scr.refresh()
            return
        with self.lock:
            if self.detail:
                self.draw_detail(scr, h, w)
            else:
                self.draw_list(scr, h, w)
            self.draw_footer(scr, h, w)
        scr.refresh()

    def draw_header(self, scr, w):
        name = self.repo["nameWithOwner"] if self.repo else os.path.basename(self.cwd.rstrip("/")) or self.cwd
        status = "loading…" if self.loading else (time.strftime("%H:%M", time.localtime(self.fetched_at)) if self.fetched_at else "")
        put(scr, 0, 1, truncate(name, w - text_width(status) - 4), curses.A_BOLD)
        put(scr, 0, w - text_width(status) - 1, status, curses.A_DIM)
        x = 1
        for t in TABS:
            label = " %s %d " % ("Issues" if t == "issues" else "PRs", len(self.items.get(t) or []))
            attr = curses.A_REVERSE | curses.A_BOLD if t == self.tab else curses.A_DIM
            put(scr, 1, x, label, attr)
            x += text_width(label) + 1
        put(scr, 1, x + 1, self.filter, color(5))
        put(scr, 2, 0, "─" * w, curses.A_DIM)

    def draw_list(self, scr, h, w):
        self.draw_header(scr, w)
        top_y, bottom_y = 3, h - 2  # rows [top_y, bottom_y)
        rows = self.items.get(self.tab) or []
        if self.error:
            for i, line in enumerate(wrap("⚠ " + self.error, w - 2)[: bottom_y - top_y]):
                put(scr, top_y + i, 1, line, color(3))
            return
        if not rows:
            msg = "loading…" if self.loading or not self.loaded_once else "no %s %s" % (self.filter, "issues" if self.tab == "issues" else "PRs")
            put(scr, top_y, 1, msg, curses.A_DIM)
            return
        per = 2  # lines per item
        visible = max(1, (bottom_y - top_y) // per)
        if self.sel < self.top:
            self.top = self.sel
        elif self.sel >= self.top + visible:
            self.top = self.sel - visible + 1
        for i, item in enumerate(rows[self.top: self.top + visible]):
            idx = self.top + i
            y = top_y + i * per
            selected = idx == self.sel
            num = "#%d" % item["number"]
            age = ago(item.get("updatedAt"))
            mark_attr, mark = self.state_mark(item)
            base = curses.A_REVERSE if selected else 0
            if selected:
                put(scr, y, 0, " " * w, base)
                put(scr, y + 1, 0, " " * w, base)
            put(scr, y, 1, mark, mark_attr | base)
            put(scr, y, 3, num, curses.A_BOLD | base)
            tx = 4 + len(num)
            put(scr, y, tx, truncate(item.get("title", ""), w - tx - len(age) - 2), base)
            put(scr, y, w - len(age) - 1, age, curses.A_DIM | base)
            sx = 3
            run_state = self.runs.get(item["number"]) if self.tab == "issues" else None
            if run_state:  # the codex-cage run, ahead of labels and assignees
                glyph, label, pair = run_label(run_state)
                tag = "%s %s" % (glyph, label)
                put(scr, y + 1, sx, truncate(tag, w - sx - 1), (color(pair) if pair else curses.A_DIM) | base)
                sx += text_width(tag) + 2
            if sx < w - 1:
                put(scr, y + 1, sx, truncate(self.subline(item), w - sx - 1), self.sub_attr(item) | base)

    def state_mark(self, item):
        state = (item.get("state") or "").upper()
        if state == "MERGED":
            return color(2), "●"
        if state == "CLOSED":
            return color(3), "●"
        if item.get("isDraft"):
            return curses.A_DIM, "○"
        return color(1), "●"

    def subline(self, item):
        author = (item.get("author") or {}).get("login", "")
        if self.tab == "prs":
            parts = [item.get("headRefName", "")]
            if item.get("isDraft"):
                parts.append("draft")
            review = {"APPROVED": "approved", "CHANGES_REQUESTED": "changes requested",
                      "REVIEW_REQUIRED": "review required"}.get(item.get("reviewDecision") or "")
            if review:
                parts.append(review)
            parts.append("@" + author)
            return " · ".join(p for p in parts if p)
        labels = ", ".join(l.get("name", "") for l in item.get("labels") or [])
        assignees = " ".join("@" + a.get("login", "") for a in item.get("assignees") or [])
        return " · ".join(p for p in (labels, assignees or "@" + author) if p)

    def sub_attr(self, item):
        if self.tab == "prs" and self.branch and item.get("headRefName") == self.branch:
            return color(4)  # PR for the branch you're on
        return curses.A_DIM

    def detail_lines(self, w):
        """Lines of (text, attr) segments; cached per item and width."""
        kind = self.detail[0]
        run_state = self.runs.get(self.detail[1]) if kind == "issues" else None
        key = (self.detail, w, id(self.detail_data), repr(run_state))
        if self._dcache and self._dcache[0] == key:
            return self._dcache[1]
        d = self.detail_data
        width = w - 2
        out = [[(l, curses.A_BOLD)] for l in wrap("#%s %s" % (d["number"], d.get("title", "")), width)]
        state = "DRAFT" if d.get("isDraft") else (d.get("state") or "")
        meta = "%s · @%s · %s ago" % (state, (d.get("author") or {}).get("login", ""), ago(d.get("createdAt")))
        out.append([(meta, self.state_mark(d)[0])])
        if kind == "prs":
            out.append([("%s → %s   +%s −%s · %s files" % (
                d.get("headRefName", ""), d.get("baseRefName", ""), d.get("additions", 0),
                d.get("deletions", 0), d.get("changedFiles", 0)), curses.A_DIM)])
        labels = ", ".join(l.get("name", "") for l in d.get("labels") or [])
        if labels:
            out.append([("labels: " + labels, color(5))])
        if run_state:
            glyph, label, pair = run_label(run_state)
            tag = "codex-cage: %s %s" % (glyph, label)
            out += wrap_spans([(tag, color(pair) if pair else curses.A_DIM)]
                              + ([(" " + run_state["prUrl"], recolor(0, 6) | curses.A_UNDERLINE)]
                                 if run_state.get("prUrl") else []), width)
        out.append([("─" * width, curses.A_DIM)])
        body = (d.get("body") or "").strip()
        out += render_markdown(body, width) if body else [[("(no description)", curses.A_DIM)]]
        comments = d.get("comments") or []
        if comments:
            out.append([])
            title = "─ %d comment%s " % (len(comments), "" if len(comments) == 1 else "s")
            out.append([(title + "─" * max(0, width - text_width(title)), curses.A_DIM)])
            for c in comments:
                out.append([])
                out.append([("@%s · %s ago" % ((c.get("author") or {}).get("login", ""), ago(c.get("createdAt"))), color(5))])
                out += render_markdown((c.get("body") or "").strip(), width)
        self._dcache = (key, out)
        return out

    def draw_detail(self, scr, h, w):
        if self.detail_error:
            put(scr, 0, 1, truncate("⚠ " + self.detail_error, w - 2), color(3))
            return
        if not self.detail_data:
            put(scr, 0, 1, "loading #%s…" % self.detail[1], curses.A_DIM)
            return
        lines = self.detail_lines(w)
        height = h - 1
        self.dscroll = max(0, min(self.dscroll, len(lines) - height))
        for i, segs in enumerate(lines[self.dscroll: self.dscroll + height]):
            x = 1
            for text, attr in segs:
                put(scr, i, x, text, attr)
                x += text_width(text)

    def draw_footer(self, scr, h, w):
        msg, at = self.flash
        if msg and time.time() - at < 4:
            put(scr, h - 1, 1, truncate(msg, w - 2), color(4))
            return
        kind = self.detail[0] if self.detail else self.tab
        run_hint = "c run  " if self.cage and kind == "issues" else ""
        if self.detail:
            hint = "j/k line  h/l page  o browser  p →agent  %sq back" % run_hint
        else:
            hint = "⏎ view  o browser  p →agent  %stab issues/PRs  f filter  r refresh  q quit" % run_hint
        put(scr, h - 1, 1, truncate(hint, w - 2), curses.A_DIM)

    # -- input

    def handle(self, key, h):
        """Return False to quit."""
        if self.detail:
            page = max(1, h - 3)
            if key in ("j", curses.KEY_DOWN):
                self.dscroll += 1
            elif key in ("k", curses.KEY_UP):
                self.dscroll = max(0, self.dscroll - 1)
            elif key in ("l", " ", "\x04", curses.KEY_NPAGE, curses.KEY_RIGHT):
                self.dscroll += page
            elif key in ("h", "b", "\x15", curses.KEY_PPAGE, curses.KEY_LEFT):
                self.dscroll = max(0, self.dscroll - page)
            elif key == "g":
                self.dscroll = 0
            elif key == "G":
                self.dscroll = 10 ** 6
            elif key == "o":
                self.open_in_browser()
            elif key == "p":
                self.send_to_agent()
            elif key == "c":
                self.start_run()
            elif key in ("\x1b", "q", "\x7f", curses.KEY_BACKSPACE):
                self.detail = self.detail_data = self.detail_error = None
            return True
        n = len(self.items.get(self.tab) or [])
        if key in ("q",):
            return False
        if key in ("j", curses.KEY_DOWN):
            self.sel = min(n - 1, self.sel + 1)
        elif key in ("k", curses.KEY_UP):
            self.sel = max(0, self.sel - 1)
        elif key == "g":
            self.sel = 0
        elif key == "G":
            self.sel = n - 1
        elif key in ("\n", "\r", "l", curses.KEY_ENTER, curses.KEY_RIGHT):
            self.open_detail()
        elif key in ("\t", "]", "["):
            self.tab = TABS[(TABS.index(self.tab) + 1) % len(TABS)]
            self.sel = self.top = 0
        elif key == "f":
            self.filter = FILTERS[(FILTERS.index(self.filter) + 1) % len(FILTERS)]
            self.sel = self.top = 0
            with self.lock:  # don't show the previous filter's rows under the new label
                self.items = {"issues": [], "prs": []}
            self.refresh()
        elif key == "r":
            self.refresh()
        elif key == "o":
            self.open_in_browser()
        elif key == "p":
            self.send_to_agent()
        elif key == "c":
            self.start_run()
        self.clamp()
        return True


_colors = {}


def color(n):
    return _colors.get(n, 0)


def init_colors():
    if not curses.has_colors():
        return
    curses.start_color()
    try:
        curses.use_default_colors()
        bg = -1
    except curses.error:
        bg = curses.COLOR_BLACK
    for n, fg in ((1, curses.COLOR_GREEN), (2, curses.COLOR_MAGENTA), (3, curses.COLOR_RED),
                  (4, curses.COLOR_YELLOW), (5, curses.COLOR_CYAN), (6, curses.COLOR_BLUE)):
        curses.init_pair(n, fg, bg)
        _colors[n] = curses.color_pair(n)


def put(scr, y, x, text, attr=0):
    h, w = scr.getmaxyx()
    if y < 0 or y >= h or x >= w:
        return
    text = truncate(text, w - x) if text_width(text) > w - x else text
    try:
        scr.addstr(y, x, text, attr)
    except curses.error:
        pass  # writing the bottom-right cell raises after it succeeds


def panel_main(scr, panel):
    curses.curs_set(0)
    init_colors()
    scr.keypad(True)
    scr.timeout(500)
    panel.refresh()
    while True:
        if not panel.loading and time.time() - panel.fetched_at > REFRESH_SECONDS and panel.fetched_at:
            panel.refresh()
        if panel.cage and time.time() - panel.runs_at > RUNS_REFRESH_SECONDS:
            panel.load_runs()
        panel.draw(scr)
        try:
            key = scr.get_wch()
        except curses.error:
            continue
        except KeyboardInterrupt:
            return
        if key == curses.KEY_RESIZE:
            continue
        if not panel.handle(key, scr.getmaxyx()[0]):
            return


def cmd_panel():
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    tab, me = os.environ.get("HERDR_TAB_ID"), os.environ.get("HERDR_PANE_ID")
    if tab and me:  # so toggle can find (and close) this panel
        panels = load_panels()
        panels[tab] = me
        save_panels(panels)
    try:
        curses.wrapper(panel_main, Panel(os.getcwd()))
    finally:
        if tab and me:
            panels = load_panels()
            if panels.get(tab) == me:
                panels.pop(tab)
                save_panels(panels)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "panel"
    if cmd == "toggle":
        cmd_toggle()
    elif cmd == "panel":
        cmd_panel()
    elif cmd == "run":
        return cmd_run(argv[2:])
    else:
        sys.stderr.write(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
